#!/bin/bash
set -e

# Idempotent: start from an empty data directory.
./stop
rm -rf lynxdb-data
./start
for i in $(seq 1 300); do
    ./check >/dev/null 2>&1 && break
    [ "$i" -eq 300 ] && { echo "load: LynxDB did not start" >&2; exit 1; }
    sleep 0.2
done

# The physical design of the index, declared when it is created, as the load
# of ClickHouse creates its table with ORDER BY.
response=$(curl -sS -w '\n%{http_code}' -X PUT -H 'Content-Type: application/json' \
    --data-binary @index.json 'http://127.0.0.1:3100/api/v1/indexes/bluesky')
code=$(tail -n1 <<< "${response}")
if [ "${code}" != 200 ] && [ "${code}" != 201 ]; then
    echo "load: creating the index failed with HTTP ${code}: $(sed '$d' <<< "${response}")" >&2
    exit 1
fi

shopt -s nullglob
files=("${BENCH_DATA_DIR}"/file_*.json.gz)
if [ "${#files[@]}" -lt "${BENCH_FILES}" ]; then
    echo "load: ${#files[@]} files in ${BENCH_DATA_DIR}, ${BENCH_FILES} needed" >&2
    exit 1
fi

# Up to 16 files are loaded in parallel, each with one request, and a failed
# request fails the load: 16 loaded 100m about a fifth faster than 8, and 32
# no faster (see README.md). Lines that are not JSON objects (a few documents
# longer than 64 KiB are split into two lines in the dataset) are kept as
# events with only _raw. load.log gets the response for every file.
URL='http://127.0.0.1:3100/api/v1/ingest?index=bluesky'
printf '%s\n' "${files[@]:0:${BENCH_FILES}}" \
    | xargs -P 16 -I '{}' bash -c 'set -o pipefail
        response=$(gzip -dc "$1" | curl -sS --fail-with-body -T - -X POST "$2") \
            || { echo "load: $1: ${response}" >&2; exit 1; }
        jq -c --arg file "$1" ".data + {file: \$file}" <<< "${response}"' _ '{}' "${URL}" \
    > load.log

# A stats request writes the buffered events to disk first.
events=$(curl -sS --fail 'http://127.0.0.1:3100/api/v1/stats' \
    | jq -e '.data.indexes[] | select(.name == "bluesky") | .events')
accepted=$(jq -s 'map(.accepted) | add' load.log)
if [ "${events}" != "${accepted}" ]; then
    echo "load: ${accepted} events accepted, but the index has ${events}" >&2
    exit 1
fi
echo "load: ${accepted} events from $(wc -l < load.log | tr -d ' ') files, $(jq -s 'map(.failed) | add' load.log) lines failed"

# The load ends with the index merged, as the loads of Elasticsearch and
# OpenSearch end with a force merge, so that the queries run with no merge in
# flight. LYNXDB_LOAD_WAIT_MERGES=no leaves the merges to the background.
[ "${LYNXDB_LOAD_WAIT_MERGES:-yes}" = "yes" ] || exit 0
response=$(curl -sS -w '\n%{http_code}' -X POST 'http://127.0.0.1:3100/api/v1/indexes/bluesky/compact')
code=$(tail -n1 <<< "${response}")
if [ "${code}" != 200 ]; then
    echo "load: compact failed with HTTP ${code}: $(sed '$d' <<< "${response}")" >&2
    exit 1
fi
echo "load: merged: $(sed '$d' <<< "${response}")"
